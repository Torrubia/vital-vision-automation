# =============================================================================
# Vital Vision n8n — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# =============================================================================

# Timezone (use a valid tz database name, e.g. America/New_York, America/Los_Angeles)
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# n8n host settings (change for production/VPS)
N8N_HOST=localhost
N8N_PROTOCOL=http

# Log level: error | warn | info | verbose | debug
N8N_LOG_LEVEL=info

# =============================================================================
# ENCRYPTION KEY — CRITICAL
# =============================================================================
# The encryption key protects all saved credentials.
# The existing Docker volume already contains a config file with the key.
# n8n reads it automatically from /home/node/.n8n/config.
#
# Only set N8N_ENCRYPTION_KEY here if you are migrating to a new volume
# or if you need to override the config file explicitly.
# Copy the exact key value from:
#   infrastructure/n8n/backups/docker/config-<timestamp>
# Do NOT change this key once credentials have been saved — they will break.
#
# N8N_ENCRYPTION_KEY=your-key-here
# =============================================================================
