# Vital Vision System — Environment Variables Example
# IMPORTANT:
# This file is only a template.
# Never put real API keys, tokens, passwords, or secrets here.
# Create a real .env file locally and keep it out of Git.

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenRouter, optional
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_model_here

# Google Sheets / Google APIs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=your_shopify_admin_api_token_here
SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here

# Canva
CANVA_API_KEY=your_canva_api_key_here

# Meta / Facebook / Instagram
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_meta_ad_account_id_here
META_PAGE_ID=your_meta_page_id_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Omnisend
OMNISEND_API_KEY=your_omnisend_api_key_here

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=your_local_encryption_key_here

# Project settings
PROJECT_NAME=Vital Vision System
BRAND_NAME=Vital Vision Shop
PRIMARY_MARKET=United States
AUTO_PUBLISH=false
REQUIRE_HUMAN_APPROVAL=true

# Add real API keys only in .env
# Never commit .env to GitHub

# --- Google Gemini Image API ---
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-1.5-flash
RUN_IMAGE_GENERATION=false

# --- Visual Quiz Builder (VQB) API ---
# Base URL (confirmed production endpoint)
VQB_PUBLIC_API_BASE_URL=https://api-production.visualquizbuilder.com/api/public
# Keys — add real values in .env only, never here
VQB_PRIVATE_API_KEY=
VQB_PUBLIC_API_KEY=
VQB_BROWSER_API_KEY=
# Quiz IDs — find in VQB dashboard
VQB_ORGANIC_QUIZ_ID=
VQB_PAID_QUIZ_ID=
# Safety: must be read_only — scripts will exit(1) otherwise
VQB_API_MODE=read_only
