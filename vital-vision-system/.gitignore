# Environment variables and secrets
.env
.env.local
.env.production
.env.development
*.env

# API keys and tokens
*token*
*secret*
*apikey*
*api-key*
credentials.json
service-account.json

# n8n local data
.n8n/
n8n_data/
docker_n8n/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
*.log
logs/*.log

# System files
.DS_Store
Thumbs.db

# Node / package folders
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
.cache/
.tmp/
temp/

# Local editor files
.vscode/settings.json
.idea/

# Large exports
exports/
*.zip
*.mp4
*.mov
*.psd
*.ai

# Do not ignore documentation folders
!vital-vision-system/logs/
!vital-vision-system/logs/*.md

# Generated output — runtime artifacts, not source code
assets/generated/*
assets/prompts/*
reports/vqb/*
# VQB backups — pre-write quiz state snapshots, never commit
backups/
# Keep planning docs and placeholder files — gitignore excludes only runtime output
!assets/generated/.gitkeep
!assets/prompts/.gitkeep
!reports/vqb/.gitkeep
!reports/vqb/*.md

# Claude / Antigravity local permissions
.claude/settings.local.json

# Secrets and credentials
secrets/
*service-account*.json
*credentials*.json
*secret*.json
*token*.json
*.pem
*.key

git check-ignore .env
