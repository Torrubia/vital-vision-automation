AUTO_PUBLISH=false
REQUIRE_HUMAN_APPROVAL=true

# Add real API keys only in .env
# Never commit .env to GitHub

# --- Google Gemini Image API ---
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-1.5-flash
RUN_IMAGE_GENERATION=false

# --- Visual Quiz Builder (VQB) API ---
# Base URL (confirmed production endpoint)
VQB_PUBLIC_API_BASE_URL=https://api-production.visualquizbuilder.com/api/public
# Keys — add real values in .env only, never here
VQB_PRIVATE_API_KEY=
VQB_PUBLIC_API_KEY=
VQB_BROWSER_API_KEY=
# Quiz IDs — find in VQB dashboard
VQB_ORGANIC_QUIZ_ID=
VQB_PAID_QUIZ_ID=
# Safety: must be read_only — scripts will exit(1) otherwise
VQB_API_MODE=read_only
