{
  "name": "vital-vision-automation",
  "version": "1.0.0",
  "description": "Vital Vision Shop — Safe organic content automation. No auto-publish. No API calls without explicit enablement.",
  "private": true,
  "scripts": {
    "image:check": "node scripts/image/check-env.js",
    "image:generate:test": "node scripts/image/generate-image-placeholder.js",
    "shopify:product-seo-report": "node scripts/shopify/update-product-seo.js",
    "shopify:product-seo-apply": "node scripts/shopify/update-product-seo.js --apply",
    "seo:check-copy": "node scripts/seo/check-seo-copy-compliance.js",
    "result:check-copy": "node scripts/seo/check-result-page-compliance.js",
    "pagefly:observe": "node scripts/pagefly/observe-pagefly-editor.js",
    "pagefly:apply-hero": "node scripts/pagefly/apply-hero-sections.js",
    "competitors:queue-dry-run": "node scripts/queue-competitors-from-master.js",
    "competitors:queue-write": "node scripts/queue-competitors-from-master.js --write",
    "organic:queue:mvp": "node scripts/generate-organic-content-queue.js",
    "organic:queue:format": "node scripts/format-organic-content-queue.js",
    "organic:queue:format:apply": "node scripts/format-organic-content-queue.js --apply",
    "organic:packs:dry-run": "node scripts/generate-publishing-packs.js",
    "organic:packs:write": "node scripts/generate-publishing-packs.js --write",
    "wavespeed:build": "node infrastructure/n8n/wavespeed/build-workflow.js",
    "wavespeed:test": "node --test infrastructure/n8n/wavespeed/test/ledger-core.test.js",
    "wavespeed:validate": "node infrastructure/n8n/wavespeed/validate-workflow.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.0.0",
    "googleapis": "^173.0.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "notes": "AUTO_PUBLISH=false. REQUIRE_HUMAN_APPROVAL=true. RUN_IMAGE_GENERATION=false by default."
}
